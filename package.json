{
  "name": "agentfabric",
  "version": "0.1.0",
  "description": "Business Workspace built on top of modern Agent Runtime platforms.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:init": "tsx platform/storage/init.ts",
    "migrate:agentcms": "tsx scripts/migrate-agentcms-data.ts",
    "seed:demo-situations": "tsx scripts/seed-demo-situations.ts",
    "dev": "tsx scripts/with-hermes-env.ts --watch platform/server/index.ts",
    "dev:no-watch": "tsx scripts/with-hermes-env.ts platform/server/index.ts",
    "start:hermes": "tsx scripts/with-hermes-env.ts dist/platform/server/index.js",
    "build": "tsc",
    "start": "node dist/platform/server/index.js",
    "cli": "tsx scripts/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^5.1.0",
    "playwright-core": "^1.61.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
